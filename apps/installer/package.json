{
  "name": "@homepanel/installer",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "homepanel setup / homepanel doctor — guided HomePanel + Home Assistant setup, optionally driven by a free AI guide",
  "bin": {
    "homepanel": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js setup"
  },
  "dependencies": {
    "@homepanel/ai": "workspace:*",
    "@homepanel/protocol": "workspace:*",
    "@inquirer/prompts": "^8.7.3",
    "mqtt": "^5.16.0",
    "multicast-dns": "^7.2.5",
    "picocolors": "^1.1.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
