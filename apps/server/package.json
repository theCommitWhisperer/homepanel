{
  "name": "@homepanel/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "homepanel-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json && node dist/index.js",
    "demo": "tsc -p tsconfig.build.json && node dist/index.js --demo"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.0.2",
    "@homepanel/ai": "workspace:*",
    "@homepanel/protocol": "workspace:*",
    "fastify": "^5.4.0",
    "mqtt": "^5.16.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "data-example",
    "README.md"
  ]
}
