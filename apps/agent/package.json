{
  "name": "@homepanel/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HomePanel PC agent: hardware sensors, drives and allowlisted actions over MQTT",
  "bin": {
    "homepanel-agent": "dist/homepanel-agent.mjs"
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts run --mock"
  },
  "dependencies": {
    "@homepanel/protocol": "workspace:*",
    "mqtt": "^5.16.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aedes": "^1.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
