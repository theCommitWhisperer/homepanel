{
  "name": "@homepanel/desktop-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "HomePanel desktop window: system check, setup runs and control panel (served by HomePanel.exe on 127.0.0.1)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mock": "node dev/mock.mjs",
    "screenshots": "node dev/screenshots.mjs",
    "e2e:real": "node dev/e2e-real.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
